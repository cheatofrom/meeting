# 服务器配置
ASR_HOST=0.0.0.0
ASR_PORT=10095
ASR_SSL_CERT=./ssl_key/server.crt
ASR_SSL_KEY=./ssl_key/server.key

# 模型配置
ASR_MODEL_PATH=./models
ASR_DEVICE=cuda
ASR_NGPU=1

# 模型路径 (可选，留空则使用默认模型)
ASR_MODEL=
VAD_MODEL=
PUNC_MODEL=

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/funasr.log

# 前端配置
REACT_APP_SERVER_URL=wss://localhost:10095
REACT_APP_MAX_FILE_SIZE=104857600
REACT_APP_SUPPORTED_FORMATS=wav,mp3,aac,flac,m4a,ogg

# 数据库配置 (如果需要)
# DATABASE_URL=sqlite:///./meeting_asr.db

# Redis配置 (如果需要缓存)
# REDIS_URL=redis://localhost:6379

# 安全配置
# SECRET_KEY=your-secret-key-here
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# 性能配置
MAX_CONCURRENT_CONNECTIONS=100
AUDIO_BUFFER_SIZE=4096
CHUNK_SIZE=1024

# 功能开关
ENABLE_VAD=true
ENABLE_PUNC=true
ENABLE_ITN=true
ENABLE_HOTWORDS=true

# 监控配置 (可选)
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3001